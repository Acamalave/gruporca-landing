# Copia este archivo a functions/.env y rellena los canales que quieras usar.
# Los canales vacíos se omiten sin dar error.

# --- Telegram (recomendado: gratis e instantáneo) ---
# 1. Habla con @BotFather en Telegram → /newbot → copia el token
# 2. Escríbele un mensaje a tu bot nuevo
# 3. Abre https://api.telegram.org/bot<TOKEN>/getUpdates y copia "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Correo (Gmail) ---
# GMAIL_APP_PASSWORD es una "contraseña de aplicación", NO tu contraseña normal:
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# A quién avisar (si se deja vacío, se envía al propio GMAIL_USER)
NOTIFY_EMAIL_TO=
